{
	email {$TLS_EMAIL}
	admin off
}
(security) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
	request_body {
		max_size 45MB
	}
	@api path /v1/*
	handle @api {
		reverse_proxy api:4000
	}
}
http://:8080 {
	respond /healthz "ok" 200
}
{$CUSTOMER_DOMAIN} {
	import security
	handle {
		reverse_proxy customer:3000
	}
}
{$PROVIDER_DOMAIN} {
	import security
	handle {
		reverse_proxy provider:3000
	}
}
{$ADMIN_DOMAIN} {
	import security
	handle {
		reverse_proxy admin:3000
	}
}
{$BUSINESS_DOMAIN} {
	import security
	handle {
		reverse_proxy business:3000
	}
}
{$ENTERPRISE_DOMAIN} {
	import security
	handle {
		reverse_proxy enterprise:3000
	}
}
