# pnpm setup:local generates matching local-only database credentials when .env is absent.
DATABASE_URL=postgresql://convyn:CHANGE_ME@localhost:5432/convyn
LOCAL_DB_PASSWORD=CHANGE_ME
REDIS_URL=redis://localhost:6379
PORT=4000
WEB_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:4173,http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:4000
PAYMENTS_ENABLED=false
LIVE_TRACKING_ENABLED=false
AI_ASSISTANTS_ENABLED=false

# New marketplace uses the existing DATABASE_URL and account/session system.
APP_ORIGIN=http://localhost:4173
FILE_UPLOAD_ROOT=.runtime/uploads
# Optional integrations: configure private values in environment secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/v1/marketplace/auth/google/callback
OAUTH_STATE_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
